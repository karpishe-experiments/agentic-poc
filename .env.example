# Required for the legacy execution profile. The enabled Dify runner does not use it.
OPENAI_API_KEY=

# Keep browser and automated verification deterministic. Use real for OpenAI image generation.
MODEL_RUNTIME=fake
IMAGE_PROVIDER_MODE=fake


# MongoDB is the only runtime persistence implementation. Obtain these values
# from the project maintainer and never commit real credentials.
MONGODB_URI=
MONGODB_DATABASE=kids_booklet

# Optional generation configuration.
DATA_ROOT=./data/assets
COMIC_COPY_MODE=creative
OPENAI_TRACE_INCLUDE_SENSITIVE_DATA=false

# Deployment configuration. Keep `local` and filesystem storage for development.
DEPLOYMENT_ENV=local
ASSET_STORAGE=filesystem
AWS_REGION=auto
OBJECT_STORE_ENDPOINT=
ASSETS_BUCKET=
DIAGNOSTICS_BUCKET=
RECOVERY_BUCKET=
# Required in _staging and _prod. The fixed username is `booklet`.
ACCESS_GATE_PASSWORD=
# Maintenance task definitions set this to false.
RUNNER_ENABLED=true

# Issue #65 runner: local/staging only; disabled by default. Simulated mode only.
# Use separate Community bindings. Do not reuse the diagnostic or Cloud keys.
DIFY_BOOKLET_RUNNER_ENABLED=false
DIFY_BOOKLET_BASE_URL=https://dify.uniwares.co.uk
DIFY_BOOKLET_PUBLIC_ORIGIN=http://localhost:3000
DIFY_BOOKLET_TOOL_KEY=
# Protected JSON array: manager, J01, J02 and each of the three testers.
# Each item: role, taskId, persona, appId, publishedWorkflowId, toolProviderId, apiKey.
# See docs/accepted/2026-09-27_dify-booklet-runner/M1-runner.md.
DIFY_BOOKLET_BINDINGS_JSON=
