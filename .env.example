# Required. Copy this file to .env.local and provide a real API key.
OPENAI_API_KEY=

# Keep browser and automated verification deterministic. Use real for OpenAI image generation.
MODEL_RUNTIME=fake
IMAGE_PROVIDER_MODE=fake


# MongoDB is the only runtime persistence implementation. Obtain these values
# from the project maintainer and never commit real credentials.
MONGODB_URI=
MONGODB_DATABASE=kids_booklet

# Optional generation configuration.
DATA_ROOT=./data/assets
COMIC_COPY_MODE=creative
OPENAI_TRACE_INCLUDE_SENSITIVE_DATA=false

# Deployment configuration. Keep `local` and filesystem storage for development.
DEPLOYMENT_ENV=local
ASSET_STORAGE=filesystem
AWS_REGION=auto
OBJECT_STORE_ENDPOINT=
ASSETS_BUCKET=
DIAGNOSTICS_BUCKET=
RECOVERY_BUCKET=
# Required in _staging and _prod. The fixed username is `booklet`.
ACCESS_GATE_PASSWORD=
# Maintenance task definitions set this to false.
RUNNER_ENABLED=true
