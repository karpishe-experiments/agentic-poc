# Required. Copy this file to .env.local and provide a real API key.
OPENAI_API_KEY=

# Keep browser and automated verification deterministic. Use fast for paid, low-latency development images; use real for configured-quality runs.
MODEL_RUNTIME=fake
IMAGE_PROVIDER_MODE=fake

# Optional OpenAI model-role overrides.
OPENAI_MANAGER_MODEL=gpt-5.6-luna
OPENAI_MANAGER_REASONING=low
OPENAI_SKILL_MODEL=gpt-5.6-terra
OPENAI_SKILL_REASONING=medium
OPENAI_REVIEW_MODEL=gpt-5.6-sol
OPENAI_REVIEW_REASONING=medium
OPENAI_IMAGE_MODEL=gpt-image-2

# Optional local persistence and generation configuration.
DATABASE_URL=file:./data/booklets.db
DATA_ROOT=./data/assets
IMAGE_QUALITY=balanced
COMIC_COPY_MODE=creative
OPENAI_TRACE_INCLUDE_SENSITIVE_DATA=false
