{
  "name": "kids-booklet-poc",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "npm@12.0.1",
  "scripts": {
    "preflight": "tsx scripts/preflight-env.ts",
    "dev": "npm run preflight && next dev",
    "mockup:dev": "node scripts/run-management-mockup.mjs",
    "mockup:build": "node scripts/build-management-mockup.mjs",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:mockup": "vitest run --config vitest.mockup.config.ts",
    "test:mockup:e2e": "node scripts/test-management-mockup.mjs",
    "test:agent": "tsx scripts/test-agent-fixtures.ts",
    "test:dify": "vitest run tests/integration/dify-experiment.test.ts tests/unit/dify-experiment-adapter.test.ts tests/unit/dify-experiment-http.test.ts tests/unit/dify-experiment-routes.test.ts tests/unit/dify-experiment-availability.test.ts tests/unit/dify-experiment-openapi.test.ts tests/unit/config/env.test.ts tests/unit/deployment-contracts.test.ts",
    "smoke:agent:real": "tsx scripts/smoke-real-agent.ts",
    "test:e2e": "node --import tsx scripts/run-e2e.ts",
    "test:dify:browser": "node --import tsx scripts/run-e2e.ts --dify-experiment tests/e2e/dify-experiment.spec.ts",
    "db:reset": "tsx scripts/reset-mongodb.ts",
    "db:verify": "tsx scripts/verify-mongodb.ts",
    "deploy:initialize": "tsx scripts/initialize-deployment.ts",
    "deploy:control": "tsx scripts/deployment-control.ts",
    "deploy:reset-staging": "tsx scripts/reset-staging-deployment.ts",
    "deploy:recovery": "tsx scripts/recovery.ts",
    "deploy:check": "tsx scripts/check-deployment-readiness.ts",
    "deploy:drain": "tsx scripts/wait-for-deployment-drain.ts",
    "eval:real": "tsx scripts/eval-real.ts"
  },
  "dependencies": {
    "@ai-sdk/react": "4.0.50",
    "@aws-sdk/client-s3": "3.888.0",
    "@openai/agents": "0.14.2",
    "ai": "7.0.47",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "dotenv": "17.4.2",
    "lucide-react": "1.28.0",
    "mongodb": "7.5.0",
    "next": "16.2.12",
    "openai": "7.3.0",
    "pdf-lib": "1.17.1",
    "radix-ui": "1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "server-only": "0.0.1",
    "sharp": "0.35.3",
    "tailwind-merge": "3.6.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.12",
    "jsdom": "26.1.0",
    "mongodb-memory-server": "11.2.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.1",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
