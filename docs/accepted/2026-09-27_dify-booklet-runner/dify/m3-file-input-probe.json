{
  "app": {
    "name": "issue65_m3_file_input_probe",
    "description": "Model-free ordered file-input probe. Not a Booklet runtime-access or provider test.",
    "mode": "workflow",
    "icon": "F",
    "icon_type": "emoji",
    "icon_background": "#E8F4FF",
    "use_icon_as_answer_icon": false
  },
  "dependencies": [],
  "kind": "app",
  "version": "0.7.0",
  "workflow": {
    "conversation_variables": [],
    "environment_variables": [],
    "features": { "file_upload": { "enabled": false } },
    "graph": {
      "nodes": [
        {
          "id": "start",
          "type": "custom",
          "position": { "x": 0, "y": 0 },
          "data": {
            "title": "Synthetic reference inputs",
            "type": "start",
            "variables": [
              { "variable": "correlation_id", "label": "Probe correlation ID", "type": "text-input", "required": true, "max_length": 64, "default": "", "options": [] },
              {
                "variable": "reference_files",
                "label": "Ordered synthetic images",
                "type": "file-list",
                "required": true,
                "max_length": 15,
                "allowed_file_types": ["image"],
                "allowed_file_extensions": [".png"],
                "allowed_file_upload_methods": ["local_file"]
              }
            ]
          }
        },
        {
          "id": "finish",
          "type": "custom",
          "position": { "x": 320, "y": 0 },
          "data": {
            "title": "Return original ordered files",
            "type": "end",
            "outputs": [
              { "variable": "correlation_id", "value_type": "string", "value_selector": ["start", "correlation_id"] },
              { "variable": "reference_files", "value_type": "array[file]", "value_selector": ["start", "reference_files"] }
            ]
          }
        }
      ],
      "edges": [
        { "id": "start-finish", "source": "start", "target": "finish", "sourceHandle": "source", "targetHandle": "target", "type": "custom", "data": { "sourceType": "start", "targetType": "end" } }
      ]
    }
  }
}
