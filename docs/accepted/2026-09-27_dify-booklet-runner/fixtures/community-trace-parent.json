            "title": "Verify exact lineage",
            "type": "code",
            "code_language": "python3",
            "code": "def main(correlation_id, parent_run_id, c_correlation, c_parent, c_role, c_run, c_operation, t_correlation, t_parent, t_role, t_run, t_operation):\n    if c_correlation != correlation_id or t_correlation != correlation_id or c_parent != parent_run_id or t_parent != parent_run_id:\n        raise ValueError(\"Lineage mismatch\")\n    if c_role != \"concept\" or t_role != \"tester\" or c_operation != correlation_id + \":concept\" or t_operation != correlation_id + \":tester\":\n        raise ValueError(\"Operation mismatch\")\n    if not c_run or not t_run or c_run == t_run or c_run == parent_run_id or t_run == parent_run_id:\n        raise ValueError(\"Run identity mismatch\")\n    return {\"correlation_id\": correlation_id, \"parent_run_id\": parent_run_id, \"concept_run_id\": c_run, \"tester_run_id\": t_run}\n",
