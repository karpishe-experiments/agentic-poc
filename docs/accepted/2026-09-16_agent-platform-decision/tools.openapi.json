{
  "openapi": "3.0.3",
  "info": {
    "title": "Booklet Dify lifecycle experiment",
    "version": "1.0.0",
    "description": "Specification only. Replace the server URL with the staging origin before importing. Authentication is configured in Dify, never in this file."
  },
  "servers": [
    {
      "url": "https://replace-with-staging-origin.example"
    }
  ],
  "security": [
    {
      "BookletToolKey": []
    }
  ],
  "paths": {
    "/api/experiments/dify/tools/context": {
      "post": {
        "operationId": "get_project_context",
        "summary": "get_project_context",
        "description": "Load authoritative saved story, feedback, review, approval and allowed actions. Call first on every turn.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "project_id": {
                    "type": "string",
                    "enum": [
                      "booklet-dify-trial"
                    ]
                  }
                },
                "required": [
                  "project_id"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Current authoritative context after the operation. Image dispatch returns generating.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Context"
                }
              }
            }
          },
          "default": {
            "description": "Non-2xx error; status codes and transitions are specified in plan.md.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/experiments/dify/tools/draft": {
      "post": {
        "operationId": "save_story_draft",
        "summary": "save_story_draft",
        "description": "Save or revise the full story. expected_revision must equal current_revision. Never supplies approval. Reload context on stale_revision.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "project_id": {
                    "type": "string",
                    "enum": [
                      "booklet-dify-trial"
                    ]
                  },
                  "run_id": {
                    "type": "string",
                    "format": "uuid",
                    "description": "The exact Run ID supplied in the manager turn. Never use an ID from a later turn."
                  },
                  "expected_revision": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "story": {
                    "type": "object",
                    "additionalProperties": true,
                    "properties": {
                      "title": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 1000
                      },
                      "storyline": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 16000
                      },
                      "character_description": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 16000
                      },
                      "panels": {
                        "type": "array",
                        "minItems": 3,
                        "maxItems": 3,
                        "items": {
                          "type": "object",
                          "additionalProperties": true,
                          "properties": {
                            "number": {
                              "type": "integer",
                              "minimum": 1,
                              "maximum": 3
                            },
                            "text": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 16000
                            },
                            "scene": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 16000
                            }
                          },
                          "required": [
                            "number",
                            "text",
                            "scene"
                          ]
                        }
                      },
                      "first_panel_image_prompt": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 16000
                      }
                    },
                    "required": [
                      "title",
                      "storyline",
                      "character_description",
                      "panels",
                      "first_panel_image_prompt"
                    ],
                    "description": "Dify exposes this parameter to the model as a string. Supply the complete Story as valid JSON text with no Markdown fences or wrapper. Because this schema is inline with type object, Dify parses that text into the HTTP request object. Keep this schema identical to components.schemas.Story. Exactly three ordered panel numbers 1,2,3. Prefer storyline <=100 words and panel text <=40 words; length preferences produce warnings. Hard limits: title 1000 characters, other story text 16000. Unknown Story and panel fields are ignored."
                  }
                },
                "required": [
                  "project_id",
                  "run_id",
                  "expected_revision",
                  "story"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Current authoritative context after the operation. Image dispatch returns generating.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Context"
                }
              }
            }
          },
          "default": {
            "description": "Non-2xx error; status codes and transitions are specified in plan.md.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/experiments/dify/tools/review": {
      "post": {
        "operationId": "request_review",
        "summary": "request_review",
        "description": "Request user review of the current draft, then stop. This does not approve the draft.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "project_id": {
                    "type": "string",
                    "enum": [
                      "booklet-dify-trial"
                    ]
                  },
                  "run_id": {
                    "type": "string",
                    "format": "uuid",
                    "description": "The exact Run ID supplied in the manager turn."
                  },
                  "expected_revision": {
                    "type": "integer",
                    "minimum": 1
                  }
                },
                "required": [
                  "project_id",
                  "run_id",
                  "expected_revision"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Current authoritative context after the operation. Image dispatch returns generating.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Context"
                }
              }
            }
          },
          "default": {
            "description": "Non-2xx error; status codes and transitions are specified in plan.md.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BookletToolKey": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Booklet-Tool-Key"
      }
    },
    "schemas": {
      "Story": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "storyline": {
            "type": "string",
            "minLength": 1,
            "maxLength": 16000
          },
          "character_description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 16000
          },
          "panels": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {
              "type": "object",
              "additionalProperties": true,
              "properties": {
                "number": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 3
                },
                "text": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 16000
                },
                "scene": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 16000
                }
              },
              "required": [
                "number",
                "text",
                "scene"
              ]
            }
          },
          "first_panel_image_prompt": {
            "type": "string",
            "minLength": 1,
            "maxLength": 16000
          }
        },
        "required": [
          "title",
          "storyline",
          "character_description",
          "panels",
          "first_panel_image_prompt"
        ],
        "description": "Exactly three ordered panel numbers 1,2,3. Prefer storyline <=100 words and panel text <=40 words; length preferences produce warnings. Hard limits: title 1000 characters, other story text 16000. Unknown Story and panel fields are ignored."
      },
      "Image": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "attempt_id": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "type": "string",
            "enum": [
              "generating",
              "ready",
              "failed",
              "unknown"
            ]
          },
          "revision": {
            "type": "integer",
            "minimum": 1
          },
          "attempt_count": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2
          },
          "prompt": {
            "type": "string",
            "minLength": 1,
            "maxLength": 16000
          },
          "asset_path": {
            "type": "string",
            "nullable": true
          },
          "error": {
            "type": "string",
            "nullable": true
          },
          "workflow_run_id": {
            "type": "string",
            "nullable": true
          },
          "completion_in_progress": {
            "type": "boolean"
          },
          "width": {
            "type": "integer",
            "minimum": 1,
            "nullable": true
          },
          "height": {
            "type": "integer",
            "minimum": 1,
            "nullable": true
          },
          "format": {
            "type": "string",
            "enum": [
              "png",
              "jpeg",
              "webp"
            ],
            "nullable": true
          },
          "warnings": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "attempt_id",
          "status",
          "revision",
          "attempt_count",
          "prompt",
          "asset_path",
          "error",
          "workflow_run_id",
          "completion_in_progress",
          "width",
          "height",
          "format",
          "warnings"
        ]
      },
      "Context": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "project_id": {
            "type": "string",
            "enum": [
              "booklet-dify-trial"
            ]
          },
          "idea": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "preferences": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "attempt_id": {
                "type": "string",
                "format": "uuid"
              },
              "age_range": {
                "type": "string",
                "minLength": 1,
                "maxLength": 40
              },
              "language": {
                "type": "string",
                "minLength": 1,
                "maxLength": 40
              },
              "visual_style": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "character": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              }
            },
            "required": [
              "age_range",
              "language",
              "visual_style",
              "character"
            ]
          },
          "current_revision": {
            "type": "integer",
            "minimum": 0
          },
          "story": {
            "type": "object",
            "additionalProperties": true,
            "properties": {
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000
              },
              "storyline": {
                "type": "string",
                "minLength": 1,
                "maxLength": 16000
              },
              "character_description": {
                "type": "string",
                "minLength": 1,
                "maxLength": 16000
              },
              "panels": {
                "type": "array",
                "minItems": 3,
                "maxItems": 3,
                "items": {
                  "type": "object",
                  "additionalProperties": true,
                  "properties": {
                    "number": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 3
                    },
                    "text": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 16000
                    },
                    "scene": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 16000
                    }
                  },
                  "required": [
                    "number",
                    "text",
                    "scene"
                  ]
                }
              },
              "first_panel_image_prompt": {
                "type": "string",
                "minLength": 1,
                "maxLength": 16000
              }
            },
            "required": [
              "title",
              "storyline",
              "character_description",
              "panels",
              "first_panel_image_prompt"
            ],
            "description": "Exactly three ordered panel numbers 1,2,3. Prefer storyline <=100 words and panel text <=40 words; length preferences produce warnings. Hard limits: title 1000 characters, other story text 16000. Unknown Story and panel fields are ignored.",
            "nullable": true
          },
          "review_revision": {
            "type": "integer",
            "minimum": 1,
            "nullable": true
          },
          "approved_revision": {
            "type": "integer",
            "minimum": 1,
            "nullable": true
          },
          "pending_feedback": {
            "type": "array",
            "maxItems": 5,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            }
          },
          "image": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "attempt_id": {
                "type": "string",
                "format": "uuid"
              },
              "status": {
                "type": "string",
                "enum": [
                  "generating",
                  "ready",
                  "failed",
                  "unknown"
                ]
              },
              "revision": {
                "type": "integer",
                "minimum": 1
              },
              "attempt_count": {
                "type": "integer",
                "minimum": 1,
                "maximum": 2
              },
              "prompt": {
                "type": "string",
                "minLength": 1,
                "maxLength": 16000
              },
              "asset_path": {
                "type": "string",
                "nullable": true
              },
              "error": {
                "type": "string",
                "nullable": true
              },
              "workflow_run_id": {
                "type": "string",
                "nullable": true
              },
              "completion_in_progress": {
                "type": "boolean"
              },
              "width": {
                "type": "integer",
                "minimum": 1,
                "nullable": true
              },
              "height": {
                "type": "integer",
                "minimum": 1,
                "nullable": true
              },
              "format": {
                "type": "string",
                "enum": [
                  "png",
                  "jpeg",
                  "webp"
                ],
                "nullable": true
              },
              "warnings": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "attempt_id",
              "status",
              "revision",
              "attempt_count",
              "prompt",
              "asset_path",
              "error",
              "workflow_run_id",
              "completion_in_progress",
              "width",
              "height",
              "format",
              "warnings"
            ],
            "nullable": true
          },
          "state": {
            "type": "string",
            "enum": [
              "draft_needed",
              "draft_saved",
              "awaiting_review",
              "ready_for_image",
              "generating",
              "complete",
              "image_failed"
            ]
          },
          "allowed_actions": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "enum": [
                "save_story_draft",
                "request_review",
                "illustrate_panel"
              ]
            }
          },
          "image_attempt_count": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2
          },
          "story_warnings": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "project_id",
          "idea",
          "preferences",
          "current_revision",
          "story",
          "review_revision",
          "approved_revision",
          "pending_feedback",
          "image",
          "state",
          "allowed_actions",
          "image_attempt_count",
          "story_warnings"
        ]
      },
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "error": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "code": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "message": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000
              }
            },
            "required": [
              "code",
              "message"
            ]
          }
        },
        "required": [
          "error"
        ]
      }
    }
  }
}
